declare_args() {
  i18n_support_ui = true
  i18n_support_app_preferred_language = true
  i18n_ext_part_exists = false
  if (defined(global_parts_info.global_i18n_common_ext)) {
    i18n_ext_part_exists = true
  }
  i18n_tel_core_service_enable = true
  i18n_tel_cellular_data_enable = true

  if (defined(global_parts_info) &&
      !defined(global_parts_info.telephony_core_service)) {
    i18n_tel_core_service_enable = false
  }
  if (defined(global_parts_info) &&
      !defined(global_parts_info.telephony_cellular_data)) {
    i18n_tel_cellular_data_enable = false
  }
}

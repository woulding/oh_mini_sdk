declare_args() {
  # When true (default), the Bootstrap service task is compiled and registered
  # as a SAMGR service, handling BOOT_SYS_COMPLETED/BOOT_APP_COMPLETED messages
  # to trigger APP service/feature initialization asynchronously.
  # When false, the Bootstrap service task is removed; APP init is done
  # synchronously inside InitCompleted() in samgr_lite.c instead.
  bootstrap_lite_enable_bootstrap_service = true
}

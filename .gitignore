# ===== repo/git 版本管理数据 =====
.repo/
.git/

# ===== 编译输出 / 临时环境 =====
out/
oh_venv/
*.log

# ===== 预编译工具链（可重新下载：build/prebuilts_download.sh）=====
prebuilts/

# ===== 文档库（含大量图片/zip，可按需取消注释保留部分）=====
docs/

# ===== XTS 大体积测试集（mini 系统一般不用；保留 testfwk/device_attest_lite）=====
# 注意：test/xts/tools/lite/hctest/hctest_opt_args.gni 是 gn 必需 import 文件，必须保留
test/xts/acts/
test/xts/hats/
test/xts/dcts/
test/xts/tools/*
!test/xts/tools/lite
test/xts/tools/lite/*
!test/xts/tools/lite/hctest

# ===== 与 mini 系统无关的大型三方测试集 =====
third_party/vk-gl-cts/

# ===== 芯片 SDK 非源码部分 =====
# 编译产物
device/soc/hisilicon/*/sdk/output/
device/soc/hisilicon/*/sdk/interim_binary/*
!device/soc/hisilicon/*/sdk/interim_binary/ws63
!device/soc/hisilicon/*/sdk/interim_binary/ws53
!device/soc/hisilicon/*/sdk/interim_binary/bs21e
# ws63/bs21e 的 interim_binary 只保留 bin（boot/nv 占位二进制），libs 为大体积预编译产物
device/soc/hisilicon/*/sdk/interim_binary/ws63/*
!device/soc/hisilicon/*/sdk/interim_binary/ws63/bin
device/soc/hisilicon/*/sdk/interim_binary/bs21e/*
!device/soc/hisilicon/*/sdk/interim_binary/bs21e/bin
# ws53 只保留 bin/acore/ccore（原厂随包发布的 boot/nv/hso 数据库）；
# libs/{ohos,wifi} 是每次构建由 hm_build.sh / cmake 重新生成的链接产物，不提交
device/soc/hisilicon/*/sdk/interim_binary/ws53/*
!device/soc/hisilicon/*/sdk/interim_binary/ws53/bin
!device/soc/hisilicon/*/sdk/interim_binary/ws53/acore
!device/soc/hisilicon/*/sdk/interim_binary/ws53/ccore
# 原厂工具：SDK 自带交叉编译工具链，缺它新机器无法编译（约 1.3GB，随仓库提交）
!device/soc/hisilicon/*/sdk/tools/

# ===== 个人工具配置（按需取消注释）=====
# .agents/

# ===== 系统杂项 =====
.DS_Store
Thumbs.db

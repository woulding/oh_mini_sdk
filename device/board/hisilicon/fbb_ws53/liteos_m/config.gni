  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/middleware/chips/ws53/partition/include",
  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/middleware/chips/ws53/littlefs",
  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/middleware/utils/update/inner_include",
  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/middleware/utils/common_headers",
  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/drivers/chips/ws53/include",
  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/drivers/chips/ws53/include/acore",
  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/drivers/chips/ws53/porting/include",

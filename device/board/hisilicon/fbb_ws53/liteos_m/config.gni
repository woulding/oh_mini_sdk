  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/open_source/lwip/lwip_adapter/liteos_207/src/include",
  "${ohos_root_path}device/soc/hisilicon/ws53v106/${sdk}/kernel/liteos/liteos_v208.5.0/Huawei_LiteOS/kernel/include",

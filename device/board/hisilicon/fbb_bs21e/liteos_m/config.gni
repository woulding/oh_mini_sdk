# Kernel type, e.g. "linux", "liteos_a", "liteos_m".
kernel_type = "liteos_m"

# Kernel version.
kernel_version = ""

# Board CPU type, e.g. "cortex-a7", "riscv32".
board_cpu = ""

# Board arch: bs21e uses the *_fp toolchain (riscv32_musl_b010_fp) with
# -march=rv32imfc -mabi=ilp32f, so the OHOS side must match that ABI.
board_arch = "rv32imfc"

# Toolchain name used for system compiling.
board_toolchain = "riscv32-linux-musl"

# Toolchain bundled in the bs2xv107 SDK (gcc ver107.010, _fp variant).
board_toolchain_path =
    "${ohos_root_path}device/soc/hisilicon/bs2xv107/sdk/tools/bin/compiler/riscv/cc_riscv32_musl_b010/cc_riscv32_musl_fp/bin"

# Compiler prefix.
board_toolchain_prefix = "riscv32-linux-musl-"

# Compiler type, "gcc" or "clang".
board_toolchain_type = "gcc"

# Board related common compile flags.
board_cflags = [
  "-mabi=ilp32f",
  "-falign-functions=2",
  "-msave-restore",
  "-fno-optimize-strlen",
  "-freorder-blocks-algorithm=simple",
  "-fno-schedule-insns",
  "-fno-inline-small-functions",
  "-fno-inline-functions-called-once",
  "-mtune=size",
  "-mno-small-data-limit=0",
  "-fno-aggressive-loop-optimizations",
  "-std=c99",
  "-Wpointer-arith",
  "-Wstrict-prototypes",
  "-ffunction-sections",
  "-fdata-sections",
  "-fno-exceptions",
  "-fshort-enums",
  "-Wextra",
  "-Wundef",
  "-Wno-error=undef",
  "-U",
  "PRODUCT_CFG_BUILD_TIME",
  "-D__LITEOS__",
  "-DCMSIS_OS_VER=2",
  "-DLOSCFG_COMPAT_CMSIS_VER_2",
  "-DCHIP_BS21E=1",
]
board_cxx_flags = board_cflags
board_ld_flags = []

# Board related headfiles search path.
sdk = "sdk"

board_include_dirs = [
  "${ohos_root_path}commonlibrary/utils_lite/include",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/include",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/include/driver",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/include/middleware/utils",

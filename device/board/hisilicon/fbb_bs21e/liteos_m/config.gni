  "${ohos_root_path}/kernel/liteos_m/utils/",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/kernel/liteos/liteos_v208.6.0_b017/Huawei_LiteOS/compat/cmsis",

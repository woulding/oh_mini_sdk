  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/middleware/chips/bs21e/partition/include",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/middleware/utils/update/inner_include",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/middleware/utils/common_headers",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/drivers/chips/bs2x/include",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/drivers/chips/bs2x/arch/include",
  "${ohos_root_path}device/soc/hisilicon/bs2xv107/${sdk}/drivers/chips/bs2x/porting/arch/riscv",

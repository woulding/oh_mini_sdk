config SIO_USING_V150
    bool
    prompt "SIO Using V150"
    default n

config DATA_LEN_MAX
    int
    prompt "DATA_LEN_MAX"
    default 128
    depends on SIO_USING_V150

config I2S_RX_THRESHOLD
    hex
    prompt "Threshold of the I2S RX channel"
    default 0x0
    depends on SIO_USING_V150

config I2S_TX_THRESHOLD
    hex
    prompt "Threshold of the I2S TX channel"
    default 0x0
    depends on SIO_USING_V150

config I2S_BCLK_DIV_NUM
    hex
    prompt "NUM of the I2S BCLK DIV"
    default 0x4
    depends on SIO_USING_V150

config SIO_USING_V151
    bool
    prompt "SIO Using V151"
    default n

config I2S_OUTER_CLK_IN
    bool
    prompt "I2S use outer mclk."
    default n
    depends on SIO_USING_V151

config I2S_MCLK_PIN
    int
    prompt "Choose I2S MCLK pin."
    depends on I2S_OUTER_CLK_IN
    default 12

config I2S_MCLK_PIN_MODE
    int
    prompt "Choose MCLK WS pin mode."
    depends on I2S_OUTER_CLK_IN
    default 39
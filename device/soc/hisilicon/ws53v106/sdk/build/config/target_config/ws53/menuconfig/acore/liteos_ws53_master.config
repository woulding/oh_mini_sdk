CONFIG_DRIVER_SUPPORT_RTC=y

#
# RTC Configuration
#

#
# Config RTC
#
CONFIG_RTC_MAX_RTCS_NUM=4
CONFIG_RTC_CLOCK_VALUE=32768
# CONFIG_RTC_USING_OLD_VERSION is not set

CONFIG_RTC_USING_V150=y
CONFIG_RTC_MAX_NUM=2
CONFIG_RTC_0_WIDTH_64=0
CONFIG_RTC_1_WIDTH_64=0
CONFIG_RTC_STOP_DELAY_SUPPORT=y
# CONFIG_RTC_STOP_DELAY_USING_OSAL is not set
CONFIG_RTC_STOP_DELAY_USING_TCXO=y

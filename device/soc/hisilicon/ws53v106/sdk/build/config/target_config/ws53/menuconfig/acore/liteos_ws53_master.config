CONFIG_RTC_START_DELAY_SUPPORT=y
# CONFIG_RTC_START_DELAY_USING_OSAL is not set
CONFIG_RTC_START_DELAY_USING_TCXO=y
# CONFIG_RTC_START_DELAY_USING_SYSTICK is not set

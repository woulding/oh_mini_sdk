    int
    prompt "Choose RTC Test Index."
    depends on SAMPLE_SUPPORT_RTC
    default 0

config RTC_IRQN
    int
    prompt "Choose RTC Test Irq Number."
    depends on SAMPLE_SUPPORT_RTC
    default 49

